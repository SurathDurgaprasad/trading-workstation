# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Virtual environment
venv/
.venv/

# Generated/local data (regeneratable or purely local state -- never a
# source-of-truth artifact for this project)
data/*.db
data/market/**/*.csv
data/market/**/*.json
data/dhan/
data/ml_research/
vectorstore/

# Per-symbol runtime state for the multi-symbol paper-live fleet
# (fleet-supervise --runtime-dir, live/runtime_layout.py) -- generated,
# local, never a source-of-truth artifact, same rationale as data/*.db.
runtime/

# One-off ad-hoc evidence/demonstration DBs (e.g. shadow-run/full-pipeline
# proof runs against dedicated scratch stores) -- same rationale as
# data/*.db above; the evidence lives in the report that cites the run,
# not in a committed binary SQLite file.
evidence_run/

# Raw downloaded NSE F&O bhavcopy archives (build_point_in_time_snapshots.py's
# own local cache) -- regeneratable from the real, cited NSE archive URLs
# (see quant_research/point_in_time_fno_universe.py), NSE's own bulk
# -retrieval terms of use are unverified, and this project has never
# committed raw third-party market-data archives (data/market/, data/dhan/
# above follow the same rule). The derived, committed artifact is
# POINT_IN_TIME_SNAPSHOTS.csv, not these raw zips.
audit/edge_feasibility/bhavcopy_cache/

# Personal/reference documents not part of the published project
documents/

# Local secrets (none exist in this project today -- excluded on principle;
# see the Phase 13/14/15 security notes for why real credentials must never
# land here even later)
.env
.env.*
!.env.example
*.pem
*.key

# Operator-local exchange holiday/schedule config (real dates, not
# secret, but environment-specific and never fabricated by this
# codebase -- see config/schedule.yaml.example for the template).
config/schedule.yaml
!config/schedule.yaml.example

# OS/editor noise
.DS_Store
Thumbs.db
*.log
