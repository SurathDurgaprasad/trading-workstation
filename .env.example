# Copy to .env (already .gitignore'd -- never commit the real file) or set
# these directly in your shell/secret manager. Nothing in this repository
# reads a .env file automatically; live/dhan/config.py reads these two
# names from the process environment at the moment a real Dhan call is
# about to be made, never at import time.
#
# Generate an access token from web.dhan.co -> My Profile -> Access DhanHQ
# APIs -> Access Token (valid 24 hours; renew via the RenewToken API or
# regenerate manually). See the Phase 15 report for the full flow.

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# OpenAI provider (advisory intelligence layer only -- see llm/provider.py
# and core/config.py; never read into Settings, only from the environment
# at the moment of a real call). AI_PROVIDER selects which provider
# core.config.Settings.llm_provider resolves to; everything defaults to
# ollama (the existing local dev provider) if unset.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=1024
# Administrative kill switch, independent of AI_PROVIDER/OPENAI_API_KEY --
# must be explicitly "true" before any code path will fire a real OpenAI
# request. Run `python main.py ai-health` after setting these to verify
# configuration and connectivity without spending a completion.
OPENAI_ENABLED=false

# Optional: override where the dashboard and MCP server look for each
# SQLite database file. None of these are required -- every one defaults
# to data/<name>.db under the project root (see dashboard/intelligence.py,
# live/workstation.py, mcp_server/server.py) if unset. Only set one of
# these if you need the dashboard/MCP server to point at a database file
# living somewhere other than the default `data/` directory (e.g. a
# non-default --*-db path you also passed to a CLI command, or running
# the dashboard against a different machine's data directory).
# Final-product-hardening: documented here after a config audit found
# these were read but never listed in this file.

TRADING_SCANNER_DB_PATH=
TRADING_RESEARCH_DB_PATH=
TRADING_DECISIONS_DB_PATH=
TRADING_PREDICTIONS_DB_PATH=
TRADING_PAPER_DB_PATH=
TRADING_SCHEDULER_DB_PATH=
TRADING_STATE_DB_PATH=
TRADING_LIVE_SIM_DB_PATH=
TRADING_LIVE_STATE_DB_PATH=
